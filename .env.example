# Identity of this deployment. None of it belongs in the repo.
PROJECT_NAME=family-finance-hub          # prefix of every resource name; pick once
AWS_ACCOUNT_ID=000000000000
AWS_LOGIN_PROFILE=my-profile             # laptop only: `aws login --profile ...`
HUB_DOMAIN=example.com                   # a zone in your Cloudflare account
ACCESS_TEAM_DOMAIN=myteam.cloudflareaccess.com
CLOUDFLARE_API_TOKEN=

# Create at RiseUp → /developer/tokens with scope budget:read.
# Shown once, expires after 30 days by default.
RISEUP_PAT=riseup_pat_xxx
